# Create a vector of target values
target_values <- c(-10, -2, -1, 0, 1, 2)
filter_closest_rows <- function(data, column, target) {
data %>%
filter(abs({{ column }} - target) == min(abs({{ column }} - target)))
}
# Grouped filtering for each target value and combining into a dataframe
df2 <- df %>%
group_by(attempt) %>%
do(
data.frame(
do.call(
rbind,
lapply(target_values, function(target) filter_closest_rows(., score, target))
),
stringsAsFactors = FALSE
)
) %>%
ungroup()
